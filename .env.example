# Copy to .env. Replace every CHANGE_ME value before using outside localhost.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
PORT=4000
DATABASE_URL=postgresql://sitescope:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/sitescope?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_USER=sitescope
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=sitescope
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sitescope
S3_ACCESS_KEY=sitescope
S3_SECRET_KEY=CHANGE_ME_STORAGE_PASSWORD
STORAGE_DRIVER=s3
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=SiteScope <noreply@sitescope.local>
SMTP_USER=
SMTP_PASS=
BROWSER_RUNNER_URL=http://localhost:4100
PROXY_URL=http://localhost:8080
CRUX_API_KEY=
MAX_PROJECTS=3
AUDITS_PER_DAY=5
AUDIT_TIMEOUT_MS=240000
WORKER_CONCURRENCY=1
# Optional local seed; no default account is created automatically.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
