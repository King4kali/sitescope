generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String
  name String @default("")
  role String @default("USER")
  blocked Boolean @default(false)
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  tokens AuthToken[]
  projects Project[]
  usageEvents UsageEvent[]
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model AuthToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  kind String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model Project {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  name String
  origin String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  audits Audit[]
  @@index([ownerId])
}
model Audit {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  targetUrl String
  finalUrl String?
  status String @default("QUEUED")
  stage String @default("Queued")
  progress Int @default(0)
  startedAt DateTime?
  finishedAt DateTime?
  errorCode String?
  idempotencyKey String? @unique
  createdAt DateTime @default(now())
  configJson Json @default("{}")
  toolVersionsJson Json @default("{}")
  pages AuditPage[]
  results AuditResult[]
  findings Finding[]
  artifacts Artifact[]
  events AuditEvent[]
  exports Export[]
  usageEvents UsageEvent[]
  @@index([projectId,createdAt(sort:Desc)])
  @@index([status,createdAt])
}
model AuditPage {
  id String @id @default(uuid()) @db.Uuid
  auditId String @db.Uuid
  audit Audit @relation(fields:[auditId],references:[id],onDelete:Cascade)
  url String
  httpStatus Int?
  responseTimeMs Int?
  title String?
  metaJson Json @default("{}")
  createdAt DateTime @default(now())
  findings Finding[]
  @@unique([auditId,url])
}
model AuditResult {
  id String @id @default(uuid()) @db.Uuid
  auditId String @db.Uuid
  audit Audit @relation(fields:[auditId],references:[id],onDelete:Cascade)
  module String
  device String @default("all")
  status String
  score Float?
  metricsJson Json @default("{}")
  rawDataJson Json @default("{}")
  errorCode String?
  durationMs Int @default(0)
  @@unique([auditId,module,device])
}
model Finding {
  id String @id @default(uuid()) @db.Uuid
  auditId String @db.Uuid
  audit Audit @relation(fields:[auditId],references:[id],onDelete:Cascade)
  pageId String? @db.Uuid
  page AuditPage? @relation(fields:[pageId],references:[id],onDelete:SetNull)
  category String
  ruleId String
  severity String
  title String
  description String
  recommendation String
  evidenceJson Json @default("{}")
  @@index([auditId,severity])
}
model Artifact {
  id String @id @default(uuid()) @db.Uuid
  auditId String @db.Uuid
  audit Audit @relation(fields:[auditId],references:[id],onDelete:Cascade)
  kind String
  storageKey String @unique
  mimeType String
  sizeBytes Int
  createdAt DateTime @default(now())
  expiresAt DateTime?
  @@index([auditId])
}
model Export {
  id String @id @default(uuid()) @db.Uuid
  auditId String @db.Uuid
  audit Audit @relation(fields:[auditId],references:[id],onDelete:Cascade)
  status String @default("QUEUED")
  storageKey String?
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([auditId])
}
model UsageEvent {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  auditId String? @unique @db.Uuid
  audit Audit? @relation(fields:[auditId],references:[id],onDelete:SetNull)
  eventType String
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  auditId String @db.Uuid
  audit Audit @relation(fields:[auditId],references:[id],onDelete:Cascade)
  eventType String
  stage String
  message String
  createdAt DateTime @default(now())
  @@index([auditId,createdAt])
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  aggregateId String @db.Uuid
  eventType String
  payloadJson Json
  publishedAt DateTime?
  createdAt DateTime @default(now())
  @@index([publishedAt,createdAt])
}
